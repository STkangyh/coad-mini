data/labels.npy

# ── Local subset exports (large regenerated manifests) ────────
data/subset/*_subset.csv
data/subset/*_subset.json
data/subset/validation_subset.csv
data/subset/validation_subset.json

# ── Local session orchestration scripts (hardcoded paths/PIDs) ─
dev/auto_run_l14.sh
dev/pipeline_driver.py

# ── Misc local logs ───────────────────────────────────────────
*.log

# ── Third-party checkouts (PyCIL etc. — see benchmarks/pycil/README.md) ──
external/
