# ── OS / editor ───────────────────────────────────────────────
.DS_Store
.idea/
.vscode/

# ── Python env / caches ───────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Claude Code local state (worktrees, IDE launch config, local settings) ──
